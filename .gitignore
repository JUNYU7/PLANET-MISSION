# ============================================================
# 行星遥感原始数据（合计约 9.5 GB）
# 这些是 NASA / USGS 的公开产品，不是本项目的代码，
# 体积远超 Git 单文件 100 MB 上限，且许可条款要求从发布方获取。
# 获取方式见 README「数据准备」一节。
# ============================================================
data/
*.tif
*.tiff
*.jp2
*.img
*.IMG
*.hdr
*.lbl
*.dem
*.DEM

# ============================================================
# 区域中间产物（约 344 MB，可由 backend 管线完整重新生成）
# 高程场 / 语义栅格 / 判读图层 / 纹理 / Gazebo 网格，
# 生成命令见 README。提交这些会让仓库增大两个数量级。
# ============================================================
dataset_repo/

# ============================================================
# 软著登记材料（含界面截图与申请表相关内容，不属开源代码）
# ============================================================
shots/
_shared/out/
_shared/_edge_profile/
_shared/*.jpg

# ============================================================
# 本地工具缓存与IDE/代理数据（非项目代码）
# ============================================================
.playwright-cli/
frontend/.playwright-cli/
.codebuddy/

# ============================================================
# 软著登记材料的构建脚本与正文，以及生成的 PDF / 截图。
# 这部分内容与开源代码解耦：软著材料在本地生成，不进公开仓库。
# ============================================================
_shared/

# ============================================================
# 口令与密钥。code.txt 曾存放软著平台登录口令，已按口令文件处理：
# 一律不得进入仓库，也不得以任何形式外泄。
# ============================================================
code.txt
*.pem
*.key
*.p12
*.pfx
id_rsa*
.env
.env.*
secrets.*
credentials.*
*.htpasswd

# ============================================================
# 依赖与构建产物
# ============================================================
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.log
*.err
.DS_Store
Thumbs.db
.idea/
.vscode/
